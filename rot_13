#include <unistd.h>

void   ft_rot_13(char *s)
{
    while (*s)
    {
       if ((*s >= 'a' && *s <= 'm') || (*s >= 'A' && *s <= 'M'))
            *s = *s + 13;
        else if ((*s >= 'n' && *s <= 'z') || (*s >= 'N' && *s <= 'Z'))
            *s = *s - 13;
        
        write(1, s, 1);
        s++;
    }
}

int main (int argc, char ** argv)
{
    if (argc == 2)
        ft_rot_13(argv[1]);
    write(1, "\n", 1);
}
